# Common prerequisites. Run one operation per instance.
# Only these common settings and the mappings required by the selected
# operation are needed; inactive operation settings may remain absent.
TRUSTDECK_OPERATION=
# ONE_SHOT imports all rows once and exits (status 0); POLLING keeps reading new rows
CONNECTOR_MODE=ONE_SHOT
# Delay between two polls once all rows were read (POLLING only)
CONNECTOR_POLL_INTERVAL=60s

# Source database. Either a complete JDBC URL, or dialect, host, (port,) and name.
# Built URLs require TLS with certificate validation; put truststore settings into
# connector.database.connection-properties in config/instance/application.yaml.
DB_URL=
# SQLSERVER, POSTGRESQL, OTHER (FETCH FIRST), or OTHER_LIMIT (LIMIT); detected from DB_URL when empty
DB_DIALECT=SQLSERVER
DB_HOST=
DB_PORT=
DB_NAME=
# SQL login with SELECT permission on the source table only
DB_USERNAME=
DB_PASSWORD=
# Only for drivers added to drivers/ (see drivers/README.md)
DB_DRIVER_CLASS_NAME=
DB_QUERY_TIMEOUT=60s

# Source table. The key must be unique; the progress column (default: the key)
# must only increase for new rows. Rows with a NULL key or progress are skipped.
SOURCE_SCHEMA=dbo
SOURCE_TABLE=
SOURCE_KEY_COLUMN=
SOURCE_PROGRESS_COLUMN=
# Optional filter condition without the WHERE keyword, e.g. status = 'final'
SOURCE_WHERE=
SOURCE_PAGE_SIZE=500

# Common TrustDeck service account and resource targets.
TRUSTDECK_SERVICE_URL=
# HTTP timeouts per TrustDeck call (defaults 5s/30s)
TRUSTDECK_CONNECT_TIMEOUT=5s
TRUSTDECK_READ_TIMEOUT=30s
KEYCLOAK_TOKEN_ENDPOINT=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
TRUSTDECK_PROJECT=
TRUSTDECK_ENTITY_TYPE=
TRUSTDECK_DOMAIN=

# Shared and operation-specific mappings. Values are column names of the source
# table (case-insensitive). See README.md for the selected operation's requirements.
SOURCE_IDENTIFIER_COLUMN=
SOURCE_IDTYPE_COLUMN=
SOURCE_PSN_COLUMN=
SOURCE_VALIDITY_TIME_COLUMN=
SOURCE_DOMAIN_COLUMN=
SOURCE_VALID_FROM_COLUMN=
SOURCE_VALID_TO_COLUMN=
SOURCE_USERNAME_COLUMN=
SOURCE_ENTITY_TYPE_COLUMN=
SOURCE_ENTITY_ID_COLUMN=
SOURCE_OLD_IDENTIFIER_COLUMN=
SOURCE_OLD_IDTYPE_COLUMN=
SOURCE_OLD_PSN_COLUMN=
SOURCE_NEW_IDENTIFIER_COLUMN=
SOURCE_NEW_IDTYPE_COLUMN=
SOURCE_NEW_PSN_COLUMN=
SOURCE_OLD_DOMAIN_COLUMN=
SOURCE_NEW_DOMAIN_COLUMN=
# Time zone of date and time columns without an offset (e.g. datetime2)
MAPPING_SOURCE_TIMEZONE=Europe/Berlin
# Format for time stamps stored as text without an offset, e.g. uuuu-MM-dd HH:mm:ss.SSS
MAPPING_DATETIME_FORMAT=

# Local state files, inside the container below /app/state. Keep the defaults so the
# files land in the mounted host directory (STATE_HOST_DIR) and connector.sh finds them.
CONNECTOR_PROGRESS_FILE=state/progress.json
CONNECTOR_DLT_FILE=state/dlt.jsonl
CONNECTOR_REVIEW_FILE=state/review.jsonl
# Host directory mounted at /app/state (Compose resolves relative paths against docker/)
STATE_HOST_DIR=../state

# Optional connector mail controls. Empty SMTP_TO disables delivery and does
# not require any SMTP transport variables. A one-shot import sends its summary here.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL_ENABLE=false
SMTP_FROM=trustdeck-sql-connector@localhost
SMTP_TO=
SUBJECT_PREFIX=[TrustDeck SQL Connector]
SMTP_COOLDOWN=15m

# Optional streamed statistics collection.
CONNECTOR_STATISTICS_ENABLED=false
CONNECTOR_STATISTICS_INTERVAL=1m
CONNECTOR_STATISTICS_OUTPUT_DIRECTORY=statistics
CONNECTOR_STATISTICS_MAX_FILE_AGE=1d
CONNECTOR_STATISTICS_MAX_FILE_SIZE=256MB
# Host directory mounted at /app/statistics (Compose resolves relative paths against docker/).
STATISTICS_HOST_DIR=../statistics

# Host port of the health endpoints and the container restart policy
HEALTH_HOST_PORT=18081
CONNECTOR_RESTART_POLICY=on-failure:5
