<?xml version="1.0" encoding="UTF-8"?>

<!--
Console log format aligned with the TrustDeck backend (ace/src/main/resources/log4j2.xml):

  [INFO]	2026-11-05 07:12:03,412 ConnectorRunner:142 Read 500 row(s) after key 1500 ...

Levels are configured in application.yaml (logging.level.*) and can be overridden with
environment variables such as LOGGING_LEVEL_ROOT=INFO or LOGGING_LEVEL_ORG_TRUSTDECK=DEBUG.
-->
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<conversionRule conversionWord="levelColor" class="org.trustdeck.connector.sql.logging.LevelColorConverter"/>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>[%levelColor(%level)]&#9;%d{ISO8601} %logger{0}:%line %message%n%exception</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<root level="WARN">
		<appender-ref ref="CONSOLE"/>
	</root>
</configuration>
